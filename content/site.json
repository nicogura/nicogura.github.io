  "changelog": [
    {
      "date": "2026-10-13",
      "type": "UPDATED",
      "title": "全修理・ニトロ補充の料金を訂正しました",
      "items": [
        "全修理の料金を1,400,000円、ニトロ補充の料金を1,000,000円へ訂正しました。",
        "経済・料金とメカニックの両ページから、同じ最新料金を確認できます。"
      ]
    },
    {
      "date": "2026-10-12",
      "type": "UPDATED",
      "title": "再起動前後の犯罪と専用車両のルールを追加しました",
      "items": [
        "定期再起動の前30分・再開後30分、緊急再起動の再開後15分は犯罪禁止です。その他の再起動は街からのアナウンスを確認し、個別の犯罪開始時刻の案内を優先してください。",
        "権限のない市民によるPD・EMS専用車両の無断使用・窃盗と、JOB専用車両の犯罪利用を禁止するルールを掲載しました。"
      ]
    },
    {
      "date": "2026-10-12",
      "type": "UPDATED",
      "title": "サーバー情報・MOD規定・EMS用品の案内を更新しました",
      "items": [
        "毎日の再起動時刻と、水曜03:00〜木曜19:00の基本定休日を掲載しました。",
        "スピードブースト・グリッチロールの禁止と、Citizen・Client MODの使用条件をまとめました。",
        "初期資金を現金・銀行それぞれ10,000,000円へ更新しました。",
        "医療用品をEMS専売品として案内し、応急処置と完治の違いを明記しました。廃止済みの医療サービスと旧商品を料金表から削除しました。",
        "ギャングカラーの登録方法・識別の注意と、FAQを更新しました。",
        "トップページの参加案内・サーバー情報と、スマホの料金表示を読みやすく整えました。"
      ]
    },
    {
      "date": "2026-10-11",
      "type": "UPDATED",
      "title": "カラー・犯罪RP・料金・Life Job・FAQを更新しました",
      "items": [
        "服装・車両の使用可能カラーと、所属内でのカラーの扱いを掲載しました。",
        "チェイスの解放条件・アタック禁止時間、職務質問・現行犯逮捕の条件を掲載しました。",
        "犯罪中の不具合確認、リセット前の選択、再発時の対応をまとめました。",
        "FAQは質問への答えを先に読める文章へ整理しました。",
        "経済の長文説明を削除し、飲食・消耗品・医療・修理の料金を更新しました。",
        "Life Jobの一覧を更新しました。木こり・電気工事は調整中です。"
      ]
    },
    {
      "date": "2026-10-10",
      "type": "UPDATED",
      "title": "公式ルール・参加ガイドを更新しました",
      "items": [
        "ライトRPの考え方と1人1キャラクターの方針を分かりやすくしました。",
        "Discordのルール確認からRxxxx申請、運営承認、再接続までの参加方法をまとめました。",
        "経済・料金、犯罪RP、ゲーム内法律、街の仕事、FAQをそれぞれのページから確認できます。",
        "スマホで読みやすい料金表と法律検索を整えました。"
      ]
    },
    {
      "date": "2026-10-05",
      "type": "UPDATED",
      "title": "v1.0.1：確認中の料金と罪状の適用条件を明確化",
      "items": [
        "カスタムなど8項目の料金は、照合に食い違いがあるため金額掲載を保留しました。通常修理・全修理・タイヤ交換は確認済み料金を掲載しています。",
        "基本罰金の表で、金額と罪状の適用条件を区別しました。適用条件が未確認の罪状は、表だけを根拠に請求しないことを明記しました。"
      ]
    },
    {
      "date": "2026-10-05",
      "type": "NEW",
      "title": "公式ルール v1.0.0 を公開",
      "items": [
        "初心者に分かりやすい共通ルールを、ガイド・お願い・注意・禁止・重大違反に分けて公開しました。",
        "確認済みの基本罰金、医療・メカニックの基準料金を掲載しました。",
        "未確定の犯罪条件・処分時間・職業条件・武器区分は「運営確認中」と明記しました。",
        "全文検索、カテゴリー、ブックマーク、個別URL、更新履歴を用意しました。"
      ]
    }
  ],
