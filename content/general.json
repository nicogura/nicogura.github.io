  "rules": [
    {
      "id": "intro-welcome",
      "number": 1,
      "title": "NicoGuraへようこそ",
      "category": "intro",
      "tags": [
        "ガイド"
      ],
      "keywords": [
        "初心者",
        "ライトRP",
        "FiveM",
        "にこぐら"
      ],
      "severity": "guide",
      "summary": "難しく考えなくて大丈夫。最低限のライトRPとマナーを守って、街で自由に楽しもう。",
      "content": [
        {
          "text": "NicoGura（にこぐら）は、みんなでゆっくり街での生活を楽しむライトRPサーバーです。FiveM初心者もRP初心者も歓迎します。完璧な演技や、細かなキャラクター設定は必要ありません。",
          "type": "paragraph"
        },
        {
          "text": "ゲーム内では「この街に暮らす一人の市民」という意識を持って、仕事や会話、街で起きる出来事を楽しんでください。自分だけでなく、一緒にいる人も楽しめる行動を大切にしましょう。",
          "type": "paragraph"
        },
        {
          "text": "ルールはみんなが気持ちよく遊ぶための最低限の約束です。分からないことは、公式Discordの「お問い合わせ窓口」から確認できます。",
          "type": "paragraph"
        }
      ],
      "updatedAt": "2026-10-10",
      "new": false,
      "featured": true,
      "status": "published",
      "contentKind": "guide"
    },
    {
      "id": "intro-reading",
      "number": 2,
      "title": "まずは基本の約束を確認しよう",
      "category": "intro",
      "tags": [
        "ガイド"
      ],
      "keywords": [
        "最低限",
        "基本",
        "法律",
        "運営対応"
      ],
      "severity": "guide",
      "summary": "全部を暗記する必要はありません。基本のマナーと禁止事項を理解し、必要なときに読み返してください。",
      "content": [
        {
          "items": [
            "一緒に遊ぶ相手を尊重する。",
            "理由のない攻撃や、外部情報を使った有利な行動をしない。",
            "不正利用や嫌がらせをしない。",
            "困ったら報復せず、Discordの「お問い合わせ窓口」へ相談する。"
          ],
          "type": "list"
        },
        {
          "text": "ルール一覧では検索やカテゴリーから必要な内容を探せます。バッジは案内の種類を表し、処分を自動的に決めるものではありません。",
          "type": "paragraph"
        },
        {
          "text": "犯罪RPは街のゲームコンテンツです。ゲーム内の法律違反にはPDが対応し、罰金・保護観察・押収・インパウンドなどが発生します。サーバールール違反は運営が対応します。",
          "type": "note"
        }
      ],
      "updatedAt": "2026-11-02",
      "new": false,
      "featured": true,
      "status": "published",
      "contentKind": "guide"
    },
    {
      "id": "basic-respect",
      "number": 3,
      "title": "相手の楽しみも大切に",
      "category": "intro",
      "tags": [
        "お願い"
      ],
      "keywords": [
        "リスペクト",
        "マナー",
        "対立",
        "口論"
      ],
      "severity": "notice",
      "summary": "市民、運営、配信者など、一緒に遊ぶ相手を尊重しましょう。",
      "content": [
        {
          "text": "RP上の対立や口論と、プレイヤー本人への攻撃は別です。ゲーム内で役として対立しても、現実の人格への誹謗中傷や嫌がらせにつなげないでください。",
          "type": "paragraph"
        },
        {
          "text": "相手が話したり行動したりできる余地を残し、自分と相手の両方が楽しめる遊び方を心がけましょう。RPとして成立するゲーム内の対立まで、一律に禁止するものではありません。",
          "type": "paragraph"
        }
      ],
      "updatedAt": "2026-11-02",
      "new": false,
      "featured": false,
      "status": "published",
      "contentKind": "rule",
      "ruleChapter": 1
    },
    {
      "id": "rp-back-and-forth",
      "number": 4,
      "title": "相手と一緒にRPを楽しもう",
      "category": "intro",
      "tags": [
        "お願い"
      ],
      "keywords": [
        "RP",
        "会話",
        "交流"
      ],
      "severity": "notice",
      "summary": "自然に街で会話して、お互いに楽しめれば大丈夫です。",
      "content": [
        {
          "text": "キャラクターとして街で経験したことをもとに、会話や行動を楽しんでください。操作ミスや言い間違いがあっても、すぐに相手を責めず、必要なことを短く確認し合いましょう。",
          "type": "paragraph"
        },
        {
          "text": "相手の会話や出来事を尊重し、関係のない場面へ繰り返し割り込んで遊びを止めないようお願いします。困ったときは、運営へ相談して大丈夫です。",
          "type": "paragraph"
        }
      ],
      "updatedAt": "2026-11-02",
      "new": false,
      "featured": false,
      "status": "published",
      "contentKind": "rule",
      "ruleChapter": 1
    },
    {
      "id": "rp-metagaming",
      "number": 5,
      "title": "ゲーム外の情報をRPに持ち込まない",
      "category": "prohibited",
      "tags": [
        "禁止"
      ],
      "keywords": [
        "メタゲーミング",
        "Metagaming",
        "メタ",
        "外部情報"
      ],
      "severity": "prohibited",
      "summary": "自分のキャラクターがゲーム内で知ることのできない情報を、ゲーム内で使うことは禁止です。",
      "content": [
        {
          "text": "Discord、配信、他人の画面、ゲーム外チャット、運営画面、外部ツールなどで得た位置・人数・計画・身元を、自分のキャラクターが知っている情報として利用しないでください。",
          "type": "paragraph"
        },
        {
          "text": "偶然情報が見えたり聞こえたりした場合も、ゲーム内の行動や仲間への連絡に利用しないでください。ゲームの状況に影響しない普段の雑談まで禁止するものではありません。",
          "type": "note"
        }
      ],
      "updatedAt": "2026-11-02",
      "new": false,
      "featured": true,
      "status": "published",
      "contentKind": "rule",
      "ruleChapter": 2
    },
    {
      "id": "rp-rdm",
      "number": 6,
      "title": "理由のない攻撃をしない（RDM）",
      "category": "prohibited",
      "tags": [
        "禁止"
      ],
      "keywords": [
        "RDM",
        "無差別",
        "攻撃",
        "殺害"
      ],
      "severity": "prohibited",
      "summary": "RP上の理由や流れがないまま、他のプレイヤーを突然攻撃・殺害する行為は禁止です。",
      "content": [
        {
          "text": "通りすがりの人へ無差別に発砲するなど、RP上の関わりがない攻撃をしないでください。「犯罪者のキャラクターだから」という理由だけで、誰でも攻撃できるわけではありません。",
          "type": "paragraph"
        },
        {
          "text": "進行中の犯罪RPや対立は、前後のやり取りと状況を含めて判断します。",
          "type": "note"
        }
      ],
      "updatedAt": "2026-11-02",
      "new": false,
      "featured": true,
      "status": "published",
      "contentKind": "rule",
      "ruleChapter": 2
    },
    {
      "id": "prohibited-cheating",
      "number": 7,
      "title": "チート・不正ツールを使わない",
      "category": "prohibited",
      "tags": [
        "重大違反"
      ],
      "keywords": [
        "チート",
        "cheat",
        "不正ツール",
        "不正改造",
        "サーバー攻撃",
        "BOT",
        "自動化"
      ],
      "severity": "serious",
      "summary": "チート・不正ツール・マクロで有利になる行為や、サーバー・他のプレイヤーを妨げる行為は禁止です。",
      "content": [
        {
          "type": "paragraph",
          "text": "チート、不正ツール、マクロなどを利用して、自分が有利になる行為は禁止です。Mod Menu、Aimbot、ESP、Wallhackなどの不正な照準・透視・改変も含みます。"
        },
        {
          "type": "paragraph",
          "text": "これらを使ったサーバーへの攻撃や、他のプレイヤーのプレイを妨げる行為は禁止です。放置、BOT、自動化によって稼ぐ行為も行わないでください。"
        }
      ],
      "updatedAt": "2026-11-02",
      "new": false,
      "featured": false,
      "status": "published",
      "contentKind": "rule",
      "ruleChapter": 2
    },
    {
      "id": "prohibited-exploit",
      "number": 8,
      "title": "バグ・複製を意図的に悪用しない",
      "category": "prohibited",
      "tags": [
        "重大違反"
      ],
      "keywords": [
        "バグ",
        "グリッチ",
        "Exploit",
        "Duplication",
        "デュープ",
        "複製",
        "資金増殖"
      ],
      "severity": "serious",
      "summary": "複製バグや、通常のプレイでは到達・発揮できない挙動を悪用することは禁止です。",
      "content": [
        {
          "type": "paragraph",
          "text": "資金・アイテム・報酬を複製したり、不正に取得したりする行為は禁止です。通常のプレイでは到達・発揮できない行為や挙動も悪用しないでください。"
        },
        {
          "type": "list",
          "items": [
            "グリッチロール、スピードブースト、無線撃ち。",
            "ヘリのドアを開けた状態での走行など、通常想定されていない挙動の利用。"
          ]
        },
        {
          "type": "paragraph",
          "text": "不具合に気づいたら追加利用を止め、発生時刻や状況をチケットで報告してください。複製や重大な脆弱性の再現方法は公開・拡散しないでください。"
        },
        {
          "type": "note",
          "text": "偶然の不具合や操作ミスと、故意の悪用は区別します。"
        }
      ],
      "updatedAt": "2026-11-02",
      "new": false,
      "featured": false,
      "status": "published",
      "contentKind": "rule",
      "ruleChapter": 2,
      "relatedRuleIds": [
        "movement-glitches",
        "administration-report"
      ]
    },
    {
      "id": "prohibited-rmt",
      "number": 9,
      "title": "ゲーム内資産と現実の対価を交換しない",
      "category": "prohibited",
      "tags": [
        "重大違反"
      ],
      "keywords": [
        "RMT",
        "リアルマネー",
        "現実通貨",
        "資産取引"
      ],
      "severity": "serious",
      "summary": "ゲーム内のお金・アイテム・権利などを、現実の通貨や対価と交換するRMTは禁止です。",
      "content": [
        {
          "text": "現実のお金や換金できる対価と引き換えにゲーム内資産を受け渡したり、取引を持ちかけたりしないでください。",
          "type": "paragraph"
        }
      ],
      "updatedAt": "2026-11-02",
      "new": false,
      "featured": false,
      "status": "published",
      "contentKind": "rule",
      "ruleChapter": 2
    },
    {
      "id": "prohibited-harassment",
      "number": 10,
      "title": "悪質な嫌がらせをしない",
      "category": "prohibited",
      "tags": [
        "重大違反"
      ],
      "keywords": [
        "ハラスメント",
        "暴言",
        "差別",
        "粘着",
        "誹謗中傷",
        "個人情報",
        "セクハラ"
      ],
      "severity": "serious",
      "summary": "誹謗中傷、差別、暴言、粘着、性的な嫌がらせ、個人情報晒しや恐喝は禁止です。",
      "content": [
        {
          "type": "list",
          "items": [
            "現実の人格への誹謗中傷、差別、暴言。",
            "粘着、つきまとい、性的な嫌がらせなどのハラスメント。",
            "個人情報晒しや恐喝など、現実のトラブルへ発展させる行為。"
          ]
        },
        {
          "type": "paragraph",
          "text": "嫌なことがあっても、仕返しや長時間の口論を続けず、距離を取って運営へ相談してください。ゲーム内、配信、SNSでも、相手本人を尊重しましょう。"
        },
        {
          "type": "note",
          "text": "RPとして成立するキャラクター同士の対立と、プレイヤー本人への攻撃は区別します。"
        }
      ],
      "updatedAt": "2026-11-02",
      "new": false,
      "featured": false,
      "status": "published",
      "contentKind": "rule",
      "ruleChapter": 2
    },
    {
      "id": "prohibited-impersonation",
      "number": 11,
      "title": "運営や他のプレイヤーになりすまさない",
      "category": "prohibited",
      "tags": [
        "禁止"
      ],
      "keywords": [
        "なりすまし",
        "偽装",
        "運営"
      ],
      "severity": "prohibited",
      "summary": "運営、PD・EMSなどの公務員、他のプレイヤーへのなりすましは禁止です。",
      "content": [
        {
          "type": "paragraph",
          "text": "運営、PD・EMSなどの公務員、他のプレイヤーへのなりすましは禁止です。権限があると偽って従わせたり、本人の指示や本人確認を装ったりしないでください。"
        }
      ],
      "updatedAt": "2026-11-02",
      "new": false,
      "featured": false,
      "status": "published",
      "contentKind": "rule",
      "ruleChapter": 2
    },
    {
      "id": "communication-external-vc",
      "number": 13,
      "title": "外部VCで有利な情報を共有しない",
      "category": "prohibited",
      "tags": [
        "禁止"
      ],
      "keywords": [
        "外部VC",
        "Discord",
        "ボイスチャット",
        "位置共有",
        "作戦"
      ],
      "severity": "prohibited",
      "summary": "友達との普段の雑談は大丈夫です。シーンを有利に進める外部VCの情報共有は禁止です。",
      "content": [
        {
          "text": "犯罪、警察対応、戦闘、チェイス、ギャング活動などで、Discord等の外部VCを使って位置・人数・作戦・敵情報を共有し、ゲーム内で有利になる行為は禁止です。",
          "type": "paragraph"
        },
        {
          "text": "Discord等で友達同士が普通に会話すること自体は禁止しません。雑談中にシーンの情報が入っても、ゲーム内の行動や仲間への指示に利用しないでください。",
          "type": "note"
        }
      ],
      "updatedAt": "2026-11-02",
      "new": false,
      "featured": false,
      "status": "published",
      "contentKind": "rule",
      "ruleChapter": 2
    },
    {
      "id": "communication-voice",
      "number": 14,
      "title": "聞き取りやすい会話に協力しよう",
      "category": "communication",
      "tags": [
        "ガイド"
      ],
      "keywords": [
        "音量",
        "マイク",
        "会話",
        "声色"
      ],
      "severity": "guide",
      "summary": "音量や周囲の会話に気を配り、お互いに声を届けやすくしましょう。",
      "content": [
        {
          "text": "大きな音や連続した呼びかけで、他の人の会話を妨げないようお願いします。マイクの不調や音量に気づいたら、短く伝え合って調整しましょう。声色を変えたり、上手に演技したりする必要はありません。",
          "type": "paragraph"
        }
      ],
      "updatedAt": "2026-10-10",
      "new": false,
      "featured": false,
      "status": "published",
      "contentKind": "guide"
    },
    {
      "id": "vehicles-vdm",
      "number": 15,
      "title": "車を使って故意に襲わない（VDM）",
      "category": "prohibited",
      "tags": [
        "禁止"
      ],
      "keywords": [
        "VDM",
        "車両攻撃",
        "故意",
        "交通事故"
      ],
      "severity": "prohibited",
      "summary": "RP上の理由なく、車両を武器のように使って他のプレイヤーを意図的に轢く行為は禁止です。",
      "content": [
        {
          "text": "人を狙って轢く、嫌がらせのために繰り返し体当たりをするなどの行為をしないでください。",
          "type": "paragraph"
        },
        {
          "text": "普通の交通事故をVDMとして扱うものではありません。故意かどうかや前後のRPの流れを含め、状況を確認します。",
          "type": "note"
        }
      ],
      "updatedAt": "2026-11-02",
      "new": false,
      "featured": true,
      "status": "published",
      "contentKind": "rule",
      "ruleChapter": 2
    },
    {
      "id": "vehicles-courtesy",
      "number": 16,
      "title": "周りの人と車に気を配ろう",
      "category": "vehicles",
      "tags": [
        "ガイド"
      ],
      "keywords": [
        "駐車",
        "車両",
        "事故",
        "店舗"
      ],
      "severity": "guide",
      "summary": "人や仕事の動線をふさがず、事故が起きたら状況を伝え合いましょう。",
      "content": [
        {
          "text": "店舗や救護の近くでは周囲に気を配り、他の人の活動を長く妨げないようお願いします。事故や接触が起きたときは、状況を短く伝え合いましょう。",
          "type": "paragraph"
        }
      ],
      "updatedAt": "2026-10-10",
      "new": false,
      "featured": false,
      "status": "published",
      "contentKind": "guide"
    },
    {
      "id": "streaming-respect",
      "number": 31,
      "title": "配信・SNSでも相手を大切に",
      "category": "streaming",
      "tags": [
        "お願い"
      ],
      "keywords": [
        "配信",
        "SNS",
        "個人情報",
        "ゴースティング"
      ],
      "severity": "notice",
      "summary": "配信では個人情報に注意し、自衛のため衛星マークを表示してください。犯罪中はマークを消しても構いません。",
      "content": [
        {
          "type": "paragraph",
          "text": "配信する際は、他の参加者の個人情報や私的な画面が映らないよう注意してください。"
        },
        {
          "type": "paragraph",
          "text": "自衛のため、名前に「🛰」マークを表示してください。犯罪中は、マークを消しても構いません。"
        },
        {
          "type": "paragraph",
