  "rules": [
    {
      "id": "crime-combat-log",
      "number": 18,
      "title": "シーンから逃れるために退出しない",
      "category": "prohibited",
      "tags": [
        "禁止"
      ],
      "keywords": [
        "Combat Log",
        "コンバットログ",
        "退出",
        "切断",
        "クラッシュ",
        "回線落ち"
      ],
      "severity": "prohibited",
      "summary": "進行中のRPから逃げる目的で、故意にサーバーから退出するCombat Logは禁止です。",
      "content": [
        {
          "text": "警察対応、犯罪、戦闘、交渉、その他進行中のRPの結果を避けたり、不利な状況をリセットしたりする目的で、故意に退出・切断しないでください。",
          "type": "paragraph"
        },
        {
          "text": "クラッシュ、回線落ち、FiveMエラーなどの不可抗力は区別します。可能であれば再接続してRPを続け、関係者へ状況を伝えてください。戻れない場合は、可能になった時点でDiscordの「お問い合わせ窓口」へ連絡してください。",
          "type": "note"
        }
      ],
      "updatedAt": "2026-11-02",
      "new": false,
      "featured": true,
      "status": "published",
      "contentKind": "rule",
      "ruleChapter": 2
    },
    {
      "id": "crime-third-party",
      "number": 19,
      "title": "関係のないシーンを不正に壊さない",
      "category": "prohibited",
      "tags": [
        "禁止"
      ],
      "keywords": [
        "第三者",
        "割り込み",
        "妨害",
        "不正な加勢"
      ],
      "severity": "prohibited",
      "summary": "外部情報や無関係な攻撃で、進行中の犯罪や追跡を不正に有利にしたり妨げたりしないでください。",
      "content": [
        {
          "text": "当事者とゲーム内での関わりがない場面へ、ゲーム外の情報を頼りに加勢したり、無関係な攻撃で結末を変えたりする行為は禁止です。",
          "type": "paragraph"
        },
        {
          "text": "通りかかること、通常の通報や救護まで一律に禁止するものではありません。助けに入るときは、その場の安全とゲーム内での関わりを確認してください。",
          "type": "note"
        }
      ],
      "updatedAt": "2026-11-02",
      "new": false,
      "featured": false,
      "status": "published",
      "contentKind": "rule",
      "ruleChapter": 2
    },
    {
      "id": "crime-rejoin-combat",
      "number": 20,
      "title": "ゾンビ行為をしない",
      "category": "prohibited",
      "tags": [
        "禁止"
      ],
      "keywords": [
        "復帰",
        "蘇生",
        "戦闘再参加",
        "ダウン"
      ],
      "severity": "prohibited",
      "summary": "ダウンから復帰して、同じ戦闘へ再参加する行為は禁止です。",
      "content": [
        {
          "type": "paragraph",
          "text": "ダウンから蘇生・復帰した後、同じ戦闘へ戻って再参加する行為は禁止です。治療や身柄の扱いは、その場の案内に従ってください。"
        },
        {
          "type": "note",
          "text": "クラッシュからの再接続は、ダウンからの復帰と区別します。再開方法が分からない場合は運営へ相談してください。"
        }
      ],
      "updatedAt": "2026-11-02",
      "new": false,
      "featured": false,
      "status": "published",
      "contentKind": "rule",
      "ruleChapter": 2
    },
    {
      "id": "crime-probation",
      "number": 21,
      "title": "案内された参加制限を確認しよう",
      "category": "pd",
      "tags": [
        "注意"
      ],
      "keywords": [
        "保護観察",
        "制限",
        "確認"
      ],
      "severity": "important",
      "summary": "社会奉仕・保護観察の期間中は、案内された犯罪などの制限に従ってください。",
      "content": [
        {
          "type": "paragraph",
          "text": "社会奉仕・保護観察の期間中は、犯罪などが制限されます。参加できる活動と適用期間を確認し、制限に従ってください。"
        },
        {
          "type": "paragraph",
          "text": "別のアカウントや立場を使って制限を回避しないでください。自分に適用される内容が分からない場合は、PDや運営へ確認してください。"
        }
      ],
      "updatedAt": "2026-11-02",
